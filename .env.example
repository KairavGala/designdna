# Server port (used by the Express backend and unified production server)
PORT=5000

# Runtime environment: development | production | test
NODE_ENV=development

# Required for AI Visual Interpretation (keep secret — server-side only)
GEMINI_API_KEY=

# Optional Gemini model override (defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional server-side Gemini request timeout in ms (default 75000; must remain shorter than platform maxDuration)
GEMINI_TIMEOUT_MS=75000
