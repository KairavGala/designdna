{
  "name": "@designdna/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node --input-type=module -e \"import { writeFileSync } from 'node:fs'; writeFileSync('dist/package.json', JSON.stringify({ type: 'module' }, null, 2) + '\\n');\"",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
